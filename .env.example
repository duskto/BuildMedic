BUILDMEDIC_DATABASE_URL=sqlite:///./var/buildmedic.db
BUILDMEDIC_DATA_DIR=./var
BUILDMEDIC_SESSION_SECRET=replace-with-at-least-32-random-characters
BUILDMEDIC_RUNNER_URL=http://127.0.0.1:8001
BUILDMEDIC_RUNNER_TOKEN=replace-with-a-separate-random-token
BUILDMEDIC_RUNNER_BACKEND=docker
# A locally built, pinned image ID (sha256:...) is required for Docker execution.
BUILDMEDIC_RUNNER_IMAGE=
BUILDMEDIC_QUEUE_BACKEND=database
BUILDMEDIC_REDIS_URL=redis://127.0.0.1:6379/0
# OpenAI-compatible Chat Completions endpoint; no model is silently selected.
BUILDMEDIC_MODEL_BASE_URL=
BUILDMEDIC_MODEL_API_KEY=
BUILDMEDIC_MODEL_ID=
# Set deepseek for the official API; see docs/deepseek.md.
BUILDMEDIC_MODEL_PROVIDER=compatible
BUILDMEDIC_MODEL_THINKING=disabled
BUILDMEDIC_GITHUB_TOKEN=
# Cache sanitized completed Job logs within the same browser session for up to 24 hours.
BUILDMEDIC_GITHUB_LOG_CACHE_ENABLED=true
# Install the pinned optional dependency with uv sync --extra adaptive.
BUILDMEDIC_ADAPTIVE_ENABLED=false
BUILDMEDIC_COOKIE_SECURE=false
BUILDMEDIC_MODEL_TIMEOUT_SECONDS=90
BUILDMEDIC_MAX_OUTPUT_TOKENS=4096
BUILDMEDIC_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
BUILDMEDIC_RUNNER_PROFILES=
# Separate post-experiment scorer. Private bundles are configured only on that service.
BUILDMEDIC_SCORER_URL=
BUILDMEDIC_SCORER_TOKEN=
BUILDMEDIC_SCORER_SUITE_SHA256=
