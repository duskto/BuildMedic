{
  "$defs": {
    "RootCause": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "certainty": {
          "enum": [
            "supported",
            "hypothesis",
            "insufficient"
          ],
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "description",
        "evidence_ids",
        "certainty"
      ],
      "title": "RootCause",
      "type": "object"
    },
    "SourceEdit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "before": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "maxLength": 20000,
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ],
      "title": "SourceEdit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "failure_category": {
      "maxLength": 100,
      "title": "Failure Category",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "root_cause": {
      "$ref": "#/$defs/RootCause"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Limitations",
      "type": "array"
    },
    "next_action": {
      "maxLength": 1000,
      "title": "Next Action",
      "type": "string"
    },
    "patch": {
      "default": "",
      "maxLength": 40000,
      "title": "Patch",
      "type": "string"
    },
    "edits": {
      "items": {
        "$ref": "#/$defs/SourceEdit"
      },
      "maxItems": 5,
      "title": "Edits",
      "type": "array"
    }
  },
  "required": [
    "failure_category",
    "summary",
    "root_cause",
    "next_action"
  ],
  "title": "Diagnosis",
  "type": "object"
}
